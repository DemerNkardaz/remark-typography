{
  "name": "@nkardaz/remark-typography",
  "version": "1.0.3",
  "description": "Implements typography rules for MDX files.",
  "license": "MIT",
  "author": "Yalla Nkardaz",
  "keywords": [
    "typography",
    "typographic",
    "text-formatting",
    "typesetting",
    "russian",
    "english",
    "text",
    "mdast",
    "markdown",
    "unified",
    "remark",
    "remark-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemerNkardaz/remark-typography.git"
  },
  "homepage": "https://github.com/DemerNkardaz/remark-typography#readme",
  "bugs": {
    "url": "https://github.com/DemerNkardaz/remark-typography/issues"
  },
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "bundleSizeLimit": 10240,
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:js": "node esbuild.config.mjs",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:js && npm run build:types",
    "dev": "esbuild --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm run type-check",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.15.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "prettier": "^3.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "unified": "^11.0.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@nkardaz/typography-core": "^1.0.3",
    "@nkardaz/typography-rules": "^1.0.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
